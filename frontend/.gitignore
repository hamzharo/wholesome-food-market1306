# Node
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/

# Vite
node_modules/.vite/

# Env files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
cat > .gitignore << 'EOF'
# OS
.DS_Store

# Node
node_modules/
**/node_modules/

# Build
dist/
**/dist/

# Vite cache
**/.vite/

# Env
.env
.env.*
EOF
